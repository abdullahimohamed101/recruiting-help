# Local development only. Copy to .env and replace placeholder values.
NODE_ENV=development

POSTGRES_DB=recruiting_help
POSTGRES_USER=recruiting_help
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recruiting_help:local-development-only@127.0.0.1:5432/recruiting_help
TEST_DATABASE_URL=postgresql://recruiting_help:local-development-only@127.0.0.1:5432/recruiting_help_test

INTAKE_URL=http://127.0.0.1:5678/webhook/unified-intake
# Host-side scripts (intake:send) use 127.0.0.1 above.
# The discord-bot Compose service must use http://n8n:5678/webhook/unified-intake
# (pinned in infra/compose.dev.yaml). Interpolating this host URL into the bot
# container causes fetch failed because 127.0.0.1 is the bot itself.
AGGREGATOR_CALLER_ID=collector-dev
AGGREGATOR_CALLER_SECRET=development-only-hmac-secret-replace-before-shared-use
# Wrap JSON in single quotes so Docker Compose does not strip the double quotes.
AGGREGATOR_ALLOWED_SOURCES_JSON='{"github":["vanshb03/Summer2027-Internships"]}'
AGGREGATOR_CALLERS_JSON='{"collector-dev":{"secret":"development-only-hmac-secret-replace-before-shared-use","allowed_sources":{"github":["vanshb03/Summer2027-Internships"]}},"discord-bot-dev":{"secret":"development-only-hmac-secret-replace-before-shared-use","allowed_sources":{"discord_manual":["replace-with-discord-guild-id"],"slack_manual":["discord-intake"],"instagram_manual":["discord-intake"]}}}'

N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest

FEED_DESTINATION_KEY=internship-feed
AUTO_PUBLISH_CONFIDENCE=0.85
RESOLVE_REDIRECTS=false

# Optional for local AI fallback during Phase 4+.
# GEMINI_API_KEY=

# Phase 5 Discord bot (required for --profile discord / bot:dev).
# DISCORD_CLIENT_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_INTAKE_CHANNEL_ID=
# DISCORD_FEED_CHANNEL_ID=
# DISCORD_REVIEW_CHANNEL_ID=
# DISCORD_OPS_CHANNEL_ID=
# DISCORD_BOT_CALLER_ID=discord-bot-dev

# Production values are entered directly on the VPS and must not be committed.
# INTAKE_HMAC_SECRET=
# BACKUP_BUCKET=
# BACKUP_ENDPOINT=
