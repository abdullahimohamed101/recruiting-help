        "jsCode": "const item = $input.first().json;\nconst workflowName = item.workflow?.name ?? item.workflow?.id ?? 'unknown_workflow';\nconst executionId = item.execution?.id ?? null;\nconst errorCategory = item.execution?.error?.message\n  ? 'workflow_execution_error'\n  : 'unknown_error';\nreturn [{\n  json: {\n    workflow_name: String(workflowName).slice(0, 200),\n    error_category: errorCategory,\n    attempt_count: null,\n    next_retry_at: null,\n    execution_url: executionId ? `execution://${executionId}` : null,\n    source_config_id: null\n  }\n}];"
