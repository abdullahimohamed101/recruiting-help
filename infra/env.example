# Production template. Copy to .env.production on the VPS, set mode 0600,
# and replace every placeholder. Never commit the resulting file.
NODE_ENV=production

POSTGRES_DB=recruiting_help
POSTGRES_USER=recruiting_help
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://recruiting_help:replace-with-a-long-random-password@postgres:5432/recruiting_help
AGGREGATOR_DATABASE_URL=postgresql://aggregator_app_login:replace-with-an-app-password@postgres:5432/recruiting_help
AGGREGATOR_CALLERS_JSON={"collector-prod":{"secret":"replace-with-at-least-32-random-characters","allowed_sources":{"github":["vanshb03/Summer2027-Internships"]}}}

N8N_IMAGE=replace-with-a-pinned-n8n-image-tag
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/Los_Angeles

DISCORD_BOT_IMAGE=recruiting-help/discord-bot:development
COLLECTOR_IMAGE=recruiting-help/collector:development
INTAKE_API_IMAGE=recruiting-help/intake-api:development
PROCESSOR_IMAGE=recruiting-help/processor:development
FEED_DESTINATION_KEY=internship-feed
AUTO_PUBLISH_CONFIDENCE=0.85
RESOLVE_REDIRECTS=false

DISCORD_BOT_TOKEN=replace-me
GEMINI_API_KEY=replace-me
INTAKE_HMAC_SECRET=replace-with-at-least-32-random-characters

BACKUP_BUCKET=replace-me
BACKUP_ENDPOINT=https://replace-me.invalid
BACKUP_ACCESS_KEY_ID=replace-me
BACKUP_SECRET_ACCESS_KEY=replace-me
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
